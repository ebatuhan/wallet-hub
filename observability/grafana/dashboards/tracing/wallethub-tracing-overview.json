  "id": null,
  "panels": [
    {
      "datasource": {"type": "tempo", "uid": "tempo"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"query": "{ name =~ \"dashboard.*|plaid.*|assistant.*|analytics.*|insights.*|budgeting.*|http (get|post|put|patch|delete) /api/.*|http (get|post|put|patch|delete) /(dashboard|connections|plaid|assistant|accounts|transactions|budgets).*\" }", "queryType": "traceql", "refId": "A", "tableType": "traces"}],
      "title": "Recent Non-Actuator Traces",
      "type": "table"
    },
    {
      "datasource": {"type": "tempo", "uid": "tempo"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 2,
      "targets": [{"query": "{ status = error && name =~ \"dashboard.*|plaid.*|assistant.*|analytics.*|insights.*|budgeting.*|http (get|post|put|patch|delete) /api/.*|http (get|post|put|patch|delete) /(dashboard|connections|plaid|assistant|accounts|transactions|budgets).*\" }", "queryType": "traceql", "refId": "A", "tableType": "traces"}],
      "title": "Error Traces",
      "type": "table"
    },
    {
      "datasource": {"type": "tempo", "uid": "tempo"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 3,
      "targets": [{"query": "{ duration > 2s && name =~ \"dashboard.*|plaid.*|assistant.*|analytics.*|insights.*|budgeting.*|http (get|post|put|patch|delete) /api/.*|http (get|post|put|patch|delete) /(dashboard|connections|plaid|assistant|accounts|transactions|budgets).*\" }", "queryType": "traceql", "refId": "A", "tableType": "traces"}],
      "title": "Slow Traces Over 2s",
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 4,
      "targets": [{"expr": "sum by (client, server) (rate(traces_service_graph_request_total[5m]))", "legendFormat": "{{client}} -> {{server}}", "refId": "A"}],
      "title": "Tempo Service Graph Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 5,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, service) (rate(traces_spanmetrics_latency_bucket[5m])))", "legendFormat": "{{service}}", "refId": "A"}],
      "title": "p95 Span Latency From Tempo",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
