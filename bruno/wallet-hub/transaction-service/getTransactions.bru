meta {
  name: getTransactions
  type: http
  seq: 1
}

get {
  url: {{host}}/api/transactions
  body: none
  auth: inherit
}

params:query {
  ~accountId: {{accountId}}
  ~category: OTHER
  ~cursor: {{transactionCursor}}
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("should return cursor response", function() {
    const body = res.getBody();
    expect(body).to.have.property("data");
    expect(body).to.have.property("hasMore");
    expect(body).to.have.property("nextCursor");
  });
  
  test("should save transaction cursor and first transaction id", function() {
    const body = res.getBody();
    if (body.nextCursor) {
      bru.setVar("transactionCursor", body.nextCursor);
    }
    if (body.data && body.data.length > 0) {
      bru.setVar("transactionId", body.data[0].transactionId);
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
