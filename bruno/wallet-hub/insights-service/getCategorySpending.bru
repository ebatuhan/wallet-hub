meta {
  name: getCategorySpending
  type: http
  seq: 1
}

get {
  url: {{host}}/api/insights/spendings?from=2021-04-01&to=2026-04-03
  body: none
  auth: inherit
}

params:query {
  from: 2021-04-01
  to: 2026-04-03
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return spending grouped by currency", function() {
    const body = res.getBody();
    expect(body).to.have.property("userId");
    expect(body).to.have.property("currencies");
    expect(body.currencies).to.be.an("array");

    if (body.currencies.length > 0) {
      const currency = body.currencies[0];
      expect(currency).to.have.property("isoCurrencyCode");
      expect(currency).to.have.property("totalSpent");
      expect(currency).to.have.property("categories");
      expect(currency.categories).to.be.an("array");

      if (currency.categories.length > 0) {
        const category = currency.categories[0];
        expect(category).to.have.property("primaryCategoryId");
        expect(category).to.have.property("percentage");
        expect(category).to.have.property("totalAmount");
      }
    }
  });
}
