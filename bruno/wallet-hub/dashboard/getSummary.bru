meta {
  name: getSummary
  type: http
  seq: 1
}

get {
  url: {{host}}/api/dashboard/summary
  body: none
  auth: inherit
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return dashboard spending grouped by currency", function() {
    const body = res.getBody();
    expect(body).to.have.property("spending");
    expect(body.spending).to.have.property("categoryBreakdownByCurrency");
    expect(body.spending.categoryBreakdownByCurrency).to.be.an("array");
    expect(body.spending).to.have.property("yearlyTrendByCurrency");

    if (body.spending.categoryBreakdownByCurrency.length > 0) {
      const currency = body.spending.categoryBreakdownByCurrency[0];
      expect(currency).to.have.property("isoCurrencyCode");
      expect(currency).to.have.property("totalSpent");
      expect(currency).to.have.property("categoryBreakdown");
      expect(currency.categoryBreakdown).to.be.an("array");
    }

    if (body.spending.yearlyTrendByCurrency) {
      expect(body.spending.yearlyTrendByCurrency).to.have.property("seriesByCurrency");
      expect(body.spending.yearlyTrendByCurrency.seriesByCurrency).to.be.an("array");
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
