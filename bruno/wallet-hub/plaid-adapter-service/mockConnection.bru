meta {
  name: mockConnection
  type: http
  seq: 3
}

post {
  url: {{host}}/api/plaid/mock
  body: none
  auth: inherit
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("should save connection id", function() {
    const body = res.getBody();
    expect(body).to.have.property("connectionId");
    bru.setVar("connectionId", body.connectionId);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
