meta {
  name: createLinkToken
  type: http
  seq: 1
}

post {
  url: {{host}}/api/plaid/link-token
  body: json
  auth: inherit
}

body:json {
  {
    "country": "US"
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return link token", function() {
    const body = res.getBody();
    expect(body).to.have.property("linkToken");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
